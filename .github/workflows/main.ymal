# Name of workflow
name: First workflow

# Trigger workflow on push to the 'main' branch
on:
  push:
    branches:
      - Develop 

# Jobs to carry out
jobs:
  test:
    # Operating system to run job on
    runs-on: ubuntu-latest

    # Steps in job
    steps:
      # Get code from repo
      - name: Checkout code
        uses: actions/checkout@v2  

      # Use Node.js version 21.x
      - name: Use Node.js 21.x
        uses: actions/setup-node@v2 
        with:
          node-version: 21.x

      # Install dependencies
      - name: 🧰 Install Deps
        run: npm install
        
      # Run build
      - name: Run Build
        run: npm run build

      # Run tests
      - name: Run Tests
        run: npm run test


     